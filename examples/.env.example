# Copy to .env next to docker-compose.yml. Never commit the filled-in file.

TZ=America/Halifax
PUID=1000
PGID=1000
DOCKERDIR=/home/docker/docker-data

# From https://cryptostorm.is/wireguard (or the getkey flow described in README)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=10.10.0.2/32

# Optional webhook for events (n8n, ntfy, Discord...). Leave empty to disable.
CS_NOTIFY_URL=
